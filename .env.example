# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=

# Day 2 - Google (Gmail + Calendar), desktop OAuth flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Day 3 - weather + reminder delivery
WEATHER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Day 4 - Trading212 (read scopes only, demo first)
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_BASE_URL=https://demo.trading212.com/api/v0

# Leave both blank to follow the machine's own clock, which is read
# locally and sent nowhere. Fill them only to pin a city or zone the
# laptop is wrong about. Changing TZ needs an app restart: the
# scheduler reads it once at startup.
DEFAULT_LOCATION=
TZ=

# The hour a habit day rolls over, 0-11, default 5. A tick before this hour
# counts for the previous day, so going to bed at 02:00 and ticking then does
# not break a streak. Habits only: the calendar, weather and brief stay on the
# wall clock. Anything outside 0-11 falls back to 5.
DAY_ROLLOVER_HOUR=

# How many days back a missed habit tick can be corrected from the week dots,
# 0-7, default 2. 0 disables backfill entirely. The bound is the point: an
# unbounded backfill lets you type in a streak you did not keep.
HABIT_BACKFILL_DAYS=

# Web search for the interview-prep skill. tavily or brave; both have free
# tiers that cover personal use. Without a key the agent is told search is
# unavailable and will say it could not check, rather than guessing.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Local model, served by llama.cpp. See scripts/start-llama.ps1.
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_THINK_DEFAULT=false
